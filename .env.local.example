# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored — never commit real keys.
#
# The site runs WITHOUT these: the contact form falls back to a mailto: link.
# Add them when the Supabase project exists.

# Supabase → Project Settings → API
# "Project URL"
NEXT_PUBLIC_SUPABASE_URL=
# "anon" / "public" key — safe in the browser. RLS restricts it to INSERT only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL, used for canonical links, sitemap and OG tags.
# Local: http://localhost:3000   Production: https://royavosoughi.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Chatbot brain (RAG + memory + tools) ---
# The site runs without these too: /chat shows a "not available yet" state.

# Google Gemini — chat generation + embeddings (one key, has a free tier).
# Get one at https://aistudio.google.com/apikey
# Server-only. NEVER prefix with NEXT_PUBLIC_, never import in a "use client" file.
GEMINI_API_KEY=
# Optional overrides — sensible defaults are baked into lib/ai/gemini.ts.
# GEMINI_CHAT_MODEL=gemini-flash-latest
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Supabase → Project Settings → API → "service_role" secret key.
# Bypasses RLS entirely — used only by lib/supabase-admin.ts, exclusively in
# server-side API routes. Server-only. NEVER prefix with NEXT_PUBLIC_, never
# import in a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=
