# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored — never commit real keys.
#
# The site runs WITHOUT these: the contact form falls back to a mailto: link.
# Add them when the Supabase project exists.

# Supabase → Project Settings → API
# "Project URL"
NEXT_PUBLIC_SUPABASE_URL=
# "anon" / "public" key — safe in the browser. RLS restricts it to INSERT only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL, used for canonical links, sitemap and OG tags.
# Local: http://localhost:3000   Production: https://royavosoughi.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend (contact form email notifications) ---
# The contact form still saves to Supabase without this — the email is a
# best-effort notification on top, never blocks the submission.
# Get a key at https://resend.com/api-keys. Server-only.
RESEND_API_KEY=
# Optional — defaults to Resend's shared sandbox sender (onboarding@resend.dev),
# which works with no setup. Switch to an @royavosoughi.com address once that
# domain is verified in the Resend dashboard, e.g.
# RESEND_FROM_EMAIL="Roya Vosoughi <hello@royavosoughi.com>"
# RESEND_FROM_EMAIL=
# Optional — where the notification email is sent. Defaults to site.email
# (lib/site.ts).
# CONTACT_NOTIFICATION_EMAIL=

# --- ElevenLabs voice agent (site-wide floating widget) ---
# Not a secret — it's the same id that ships in the public embed snippet.
# Optional: the widget falls back to the agent id baked into
# ElevenLabsVoiceWidget.tsx if this is unset.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_8501kzxw287petfv74ank0vr0ec1

# Server-only — lets ElevenLabs write agent config (see the "editor" ElevenLabs
# API key with ONLY the "ElevenAgents: Write" endpoint enabled, everything
# else No Access). Never prefix with NEXT_PUBLIC_.
ELEVENLABS_API_KEY=
# Signing secret from the ElevenLabs workspace webhook that delivers
# post-call data to app/api/elevenlabs/webhook/route.ts — that route verifies
# every request against this before writing to the `leads` table. Get it when
# creating the webhook at https://elevenlabs.io/app/settings/webhooks (or via
# POST /v1/workspace/webhooks). Server-only.
ELEVENLABS_WEBHOOK_SECRET=

# --- Chatbot brain (RAG + memory + tools) ---
# The site runs without these too: /chat shows a "not available yet" state.

# OpenRouter — ALL chat generation goes through this one key (see
# lib/ai/model-catalog.ts for the model picker's slugs: Anthropic/Google/
# OpenAI/Qwen). Get one at https://openrouter.ai/keys
# Server-only. NEVER prefix with NEXT_PUBLIC_, never import in a "use client" file.
OPENROUTER_API_KEY=

# Embeddings — pick ONE provider in /admin/settings and set its key below.
# Google Gemini has a genuine (non-trial) free tier, so it's the default.
GEMINI_API_KEY=
# Optional override — a sensible default is baked into lib/ai/gemini.ts.
# GEMINI_EMBED_MODEL=gemini-embedding-001
# OPENAI_API_KEY=
# COHERE_API_KEY=
# VOYAGE_API_KEY=

# Supabase → Project Settings → API → "service_role" secret key.
# Bypasses RLS entirely — used only by lib/supabase-admin.ts, exclusively in
# server-side API routes. Server-only. NEVER prefix with NEXT_PUBLIC_, never
# import in a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram bot ---
# These are now just a bootstrap fallback — /admin/channels lets you set both
# and click "Save & register webhook" without touching .env.local or a
# terminal at all. DB values (channel_secrets table) always win once set.
#
# Message @BotFather on Telegram, /newbot, then paste the token it gives you.
TELEGRAM_BOT_TOKEN=
# A random shared secret YOU generate (not from Telegram) — the webhook route
# checks every incoming request carries this, so a public POST endpoint can't
# be triggered by anyone who finds the URL. Any random string works; e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# After setting this and TELEGRAM_BOT_TOKEN, run `npm run telegram:set-webhook
# -- <your public site URL>` to register it with Telegram (or use the panel).
TELEGRAM_WEBHOOK_SECRET=

# Optional — rate limiting and retention are DB-editable from /admin/security
# once security_config exists; these only matter before that row is touched.
# CHAT_RATE_LIMIT_WINDOW_MINUTES=10
# CHAT_RATE_LIMIT_MAX_MESSAGES=20

# --- Admin panel (/admin) ---
# Real per-admin login (email + password, admin_users table) with roles
# (owner/editor/operator/viewer) — see /admin/team. Without these two set,
# /admin/login shows a "not configured" message instead of a form that could
# never actually let you in.

# Break-glass bootstrap password for the FIRST 'owner' row — only works until
# that row sets a real password from /admin/team, after which this env var is
# no longer a live credential for it. Seed one admin_users row manually in
# Supabase (role='owner', password_hash=null) before first login.
ADMIN_PASSWORD=
# A random secret used to sign the admin session cookie. Any random string
# works, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Server-only. NEVER prefix with NEXT_PUBLIC_.
ADMIN_SESSION_SECRET=
