# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored — never commit real keys.
#
# The site runs WITHOUT these: the contact form falls back to a mailto: link.
# Add them when the Supabase project exists.

# Supabase → Project Settings → API
# "Project URL"
NEXT_PUBLIC_SUPABASE_URL=
# "anon" / "public" key — safe in the browser. RLS restricts it to INSERT only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL, used for canonical links, sitemap and OG tags.
# Local: http://localhost:3000   Production: https://royavosoughi.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
